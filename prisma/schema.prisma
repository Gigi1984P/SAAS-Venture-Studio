generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (NextAuth)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ============================================================
// USER & ORGANIZATION (Multi-Tenant)
// ============================================================

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime? @map("email_verified")
  image              String?
  avatarUrl          String?   @map("avatar_url")
  password           String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  memberships  Member[]
  ownedOrgs    Organization[] @relation("OwnedOrganizations")
  ventures     Venture[]

  @@map("users")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  status      String   @default("active")
  ownerId     String?  @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner       User?    @relation("OwnedOrganizations", fields: [ownerId], references: [id])
  members     Member[]

  @@map("organizations")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  roleId         String       @map("role_id")
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@map("members")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  label       String
  description String?
  level       Int          @default(0)
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now()) @map("created_at")

  members     Member[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  label       String
  category    String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// VENTURES
// ============================================================

model Venture {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?
  status        String        @default("idea") // idea, validation, mvp, growth, scale, sunset
  website       String?
  github        String?
  mrr           Int           @default(0)
  ownerId       String        @map("owner_id")
  opportunityId String?       @map("opportunity_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id])
  events        VentureEvent[]

  @@map("ventures")
}

// ============================================================
// OPPORTUNITY ENGINE (Discovery)
// ============================================================

model Opportunity {
  id            String     @id @default(cuid())
  title         String
  description   String?
  problem       String?    // Konkretes Problem
  solution      String?    // Konkrete Lösungsidee
  targetGroup   String?    @map("target_group")
  businessModel String?    @map("business_model")
  
  // Scoring (1-10)
  painScore     Int        @default(0) @map("pain_score")
  marketScore   Int        @default(0) @map("market_score")
  feasScore     Int        @default(0) @map("feas_score")
  timingScore     Int        @default(0) @map("timing_score")
  
  // Berechneter Gesamtscore
  totalScore    Int        @default(0) @map("total_score")
  
  // Marktdaten
  marketSize    String?    @map("market_size")
  competition   String?    // "low", "medium", "high"
  mrrEstimate   Int?       @map("mrr_estimate")
  
  // Status Pipeline
  status        String     @default("discovered") // discovered, validated, building, parked, killed
  priority      String     @default("medium") // low, medium, high, urgent
  
  // Quelle
  source        String     @default("manual") // manual, reddit, github, producthunt, trend
  sourceUrl     String?    @map("source_url")
  
  // Tags
  tags          String?    // JSON-Array als String
  
  // Verknüpfungen
  signals       Signal[]
  ventures      Venture[]
  gates         OpportunityGate[]
  
  // Metadaten
  createdBy     String     @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@map("opportunities")
}

model Signal {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  type          String      // "trend", "pain_point", "competitor", "keyword", "pricing"
  title         String
  description   String?
  source        String
  sourceUrl     String?     @map("source_url")
  data          Json?
  confidence    Float       @default(0.5)
  fetchedAt     DateTime    @default(now()) @map("fetched_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("signals")
}

model OpportunityGate {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  gateType        String      @map("gate_type")
  requirement     String?
  evidence        String?
  passed          Boolean     @default(false)
  passedAt        DateTime?   @map("passed_at")
  notes           String?

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("opportunity_gates")
}

model VentureEvent {
  id          String   @id @default(cuid())
  ventureId   String   @map("venture_id")
  type        String
  payload     Json
  actorId     String   @map("actor_id")
  createdAt   DateTime @default(now()) @map("created_at")

  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@map("venture_events")
}
