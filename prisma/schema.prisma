  contextWindow Int      @default(128000) @map("context_window")
  isEnabled     Boolean  @default(true) @map("is_enabled")
  isDefault     Boolean  @default(false) @map("is_default")
  costPer1kTokens Float? @map("cost_per_1k_tokens")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("agent_configs")
}

model LLMProvider {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String
  baseUrl   String   @map("base_url")
  apiKey    String?  @map("api_key")
  isEnabled Boolean  @default(true) @map("is_enabled")
  isLocal   Boolean  @default(false) @map("is_local")
  models    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("llm_providers")
}

// ============================================================
// PHASE 3: RAPID BUILDER (Venture Templates, Tech Stacks, Shared Modules)
// ============================================================

model VentureTemplate {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  category      String   // "saas", "marketplace", "ai-tool", "chrome-extension", "mobile-app"
  tags          String?
  repositoryUrl String?  @map("repository_url")
  demoUrl       String?  @map("demo_url")
  readmeContent String?  @map("readme_content") @db.Text
  setupSteps    Json?    @map("setup_steps")
  envVariables  Json?    @map("env_variables")
  features      Json?    // [{ name, description, implemented }]
  techStackIds  String?  @map("tech_stack_ids") // comma-separated tech stack IDs
  isDefault     Boolean  @default(false) @map("is_default")
  usageCount    Int      @default(0) @map("usage_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("venture_templates")
}

model TechStack {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  category      String   // "frontend", "backend", "database", "auth", "payment", "deployment", "ai", "styling"
  description   String?
  officialUrl   String?  @map("official_url")
  docsUrl       String?  @map("docs_url")
  version       String?
  whyUseIt      String?  @map("why_use_it") @db.Text
  pros          String?  @db.Text
  cons          String?  @db.Text
  setupCommand  String?  @map("setup_command")
  configExample String?  @map("config_example") @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  usageCount    Int      @default(0) @map("usage_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("tech_stacks")
}

model SharedModule {
  id            String          @id @default(cuid())
  name          String          @unique
  slug          String          @unique
  description   String?
  category      String          // "auth", "billing", "notifications", "analytics", "files", "search", "i18n"
  codeSnippet   String?         @map("code_snippet") @db.Text
  dependencies  Json?           // ["package-name@version"]
  setupGuide    String?         @map("setup_guide") @db.Text
  testCoverage  Float?          @map("test_coverage")
  isActive      Boolean         @default(true) @map("is_active")
  usageCount    Int             @default(0) @map("usage_count")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  ventureModules VentureModule[]

  @@map("shared_modules")
}

model VentureModule {
  id             String       @id @default(cuid())
  ventureId      String       @map("venture_id")
  moduleId       String       @map("module_id")
  config         Json?        // venture-specific config overrides
  status         String       @default("planned") // "planned", "installed", "configured", "active", "deprecated"
  installedAt    DateTime?    @map("installed_at")
  configuredAt   DateTime?    @map("configured_at")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  venture        Venture      @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  module         SharedModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([ventureId, moduleId])
  @@map("venture_modules")
}

// ============================================================
// ORCHESTRATOR RULES (Auto-Task-Enqueue on Status Change)
// ============================================================

model OrchestratorRule {
  id              String   @id @default(cuid())
  name            String
  triggerStatus   String   @map("trigger_status")
  minEvidence     Int      @default(0) @map("min_evidence")
  agentType       String   @map("agent_type")
  taskType        String   @map("task_type")
  priority        Int      @default(5)
  payload         Json?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("orchestrator_rules")
}

// ============================================================
// VENTURE NOTES & TODOS
// ============================================================

model VentureNote {
  id        String   @id @default(cuid())
  ventureId String   @map("venture_id")
  title     String
  content   String   @db.Text
  category  String   @default("general") // "general", "milestone", "decision", "research"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  venture   Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@map("venture_notes")
}

model VentureTodo {
  id          String    @id @default(cuid())
  ventureId   String    @map("venture_id")
  title       String
  description String?
  status      String    @default("todo") // "todo", "in_progress", "done", "cancelled"
  priority    String    @default("medium") // "low", "medium", "high", "urgent"
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  venture     Venture   @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@map("venture_todos")
}
