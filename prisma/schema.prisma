generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (NextAuth)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verifications")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

// ============================================================
// USER & ORGANIZATION (Multi-Tenant)
// ============================================================

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?      @map("email_verified")
  image         String?
  avatarUrl     String?        @map("avatar_url")
  password      String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  accounts      Account[]
  sessions      Session[]
  memberships   Member[]
  ownedOrgs     Organization[] @relation("OwnedOrganizations")
  ventures      Venture[]

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  status    String   @default("active")
  ownerId   String?  @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner     User?    @relation("OwnedOrganizations", fields: [ownerId], references: [id])
  members   Member[]

  @@map("organizations")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  roleId         String       @map("role_id")
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@map("members")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  label       String
  description String?
  level       Int              @default(0)
  isDefault   Boolean          @default(false) @map("is_default")
  createdAt   DateTime         @default(now()) @map("created_at")
  members     Member[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  label       String
  category    String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// VENTURES
// ============================================================

model Venture {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String?
  status        String           @default("idea")
  website       String?
  github        String?
  mrr           Int              @default(0)
  mau           Int              @default(0)
  churnRate     Float            @default(0) @map("churn_rate")
  cac           Int              @default(0)
  teamSize      Int              @default(0) @map("team_size")
  burnRate      Int              @default(0) @map("burn_rate")
  runway        Int              @default(0)
  ownerId       String           @map("owner_id")
  opportunityId String?          @map("opportunity_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?     @relation(fields: [opportunityId], references: [id])
  events        VentureEvent[]
  handoffs      VentureHandoff[]
  ventureModules VentureModule[]
  notes         VentureNote[]
  todos         VentureTodo[]

  @@map("ventures")
}

model VentureEvent {
  id        String   @id @default(cuid())
  ventureId String   @map("venture_id")
  type      String
  payload   Json
  actorId   String   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")
  venture   Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@map("venture_events")
}

// ============================================================
// OPPORTUNITY ENGINE (Extended)
// ============================================================

model Opportunity {
  id                         String                @id @default(cuid())
  title                      String
  description                String?
  industryId                 String?               @map("industry_id")
  personaId                  String?               @map("persona_id")
  job                        String?
  pain                       String?
  workaround                 String?
  consequence                String?
  solution                   String?
  targetGroup                String?               @map("target_group")
  businessModel              String?               @map("business_model")
  painSeverity               Int                   @default(0) @map("pain_severity")
  frequency                  Int                   @default(0)
  economicImpact             Int                   @default(0) @map("economic_impact")
  existingSpend              Int                   @default(0) @map("existing_spend")
  buyerClarity               Int                   @default(0) @map("buyer_clarity")
  reachability               Int                   @default(0)
  competitionGap             Int                   @default(0) @map("competition_gap")
  switchingMotivation        Int                   @default(0) @map("switching_motivation")
  recurringNature            Int                   @default(0) @map("recurring_nature")
  evidenceQuality            Int                   @default(0) @map("evidence_quality")
  scoreA                     Int                   @default(0) @map("score_a")
  mvpSimplicity              Int                   @default(0) @map("mvp_simplicity")
  aiLeverage                 Int                   @default(0) @map("ai_leverage")
  grossMargin                Int                   @default(0) @map("gross_margin")
  distributionAdvantage      Int                   @default(0) @map("distribution_advantage")
  lowSupportBurden           Int                   @default(0) @map("low_support_burden")
  expansionPotential         Int                   @default(0) @map("expansion_potential")
  defensibility              Int                   @default(0)
  scoreB                     Int                   @default(0) @map("score_b")
  marketScore                Int                   @default(0) @map("market_score")
  businessScore              Int                   @default(0) @map("business_score")
  studioFitScore             Int                   @default(0) @map("studio_fit_score")
  synergyScore               Int                   @default(0) @map("synergy_score")
  rightToWin                 String?               @map("right_to_win")
  confidence                 Float                 @default(0.0)
  evidenceLevel              Int                   @default(0) @map("evidence_level")
  biggestUncertainty         String?               @map("biggest_uncertainty")
  problemValidation          Float                 @default(0.0) @map("problem_validation")
  buyerValidation            Float                 @default(0.0) @map("buyer_validation")
  pricingValidation          Float                 @default(0.0) @map("pricing_validation")
  distributionValidation     Float                 @default(0.0) @map("distribution_validation")
  solutionValidation         Float                 @default(0.0) @map("solution_validation")
  retentionValidation        Float                 @default(0.0) @map("retention_validation")
  totalProblemSpend          Int?                  @map("total_problem_spend")
  addressableSpend           Int?                  @map("addressable_spend")
  potentialValueCreation     Int?                  @map("potential_value_creation")
  potentialValueCapture      Int?                  @map("potential_value_capture")
  realisticRevenuePool       Int?                  @map("realistic_revenue_pool")
  marketSize                 String?               @map("market_size")
  competition                String?
  mrrEstimate                Int?                  @map("mrr_estimate")
  acvEstimate                Int?                  @map("acv_estimate")
  status                     String                @default("discovered")
  priority                   String                @default("medium")
  source                     String                @default("manual")
  sourceUrl                  String?               @map("source_url")
  tags                       String?
  supportingEvidenceCount    Int                   @default(0) @map("supporting_evidence_count")
  contradictingEvidenceCount Int                   @default(0) @map("contradicting_evidence_count")
  validationPassed           Boolean?              @map("validation_passed")
  validationFailed           Boolean?              @map("validation_failed")
  conversionRate             Float?                @map("conversion_rate")
  cac                        Int?                  @map("cac")
  salesCycleDays             Int?                  @map("sales_cycle_days")
  pilotConversion            Float?                @map("pilot_conversion")
  retention                  Float?
  churn                      Float?
  grossMarginActual          Float?                @map("gross_margin_actual")
  arr                        Int?
  pmfScore                   Float?                @map("pmf_score")
  ventureEnded               Boolean?              @map("venture_ended")
  exitValue                  Int?                  @map("exit_value")
  roic                       Float?
  createdBy                  String                @map("created_by")
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")
  industry                   Industry?             @relation(fields: [industryId], references: [id])
  persona                    Persona?              @relation(fields: [personaId], references: [id])
  signals                    Signal[]
  painSignals                PainSignal[]
  painClusters               PainCluster[]
  claims                     OpportunityClaim[]
  ventures                   Venture[]
  gates                      OpportunityGate[]
  assumptions                Assumption[]
  experiments                Experiment[]
  competitors                Competitor[]
  scoreComponents            ScoreComponent[]
  stopConditions             StopCondition[]
  researchBudgets            ResearchBudget[]
  negativeEvidence           NegativeEvidence[]
  artifacts                  Artifact[]
  validationRuns             ValidationRun[]
  prospects                  Prospect[]
  workflowObservations       WorkflowObservation[]
  redTeamReviews             RedTeamReview[]
  unitEconomics              UnitEconomicsModel[]
  validationMemos            ValidationMemo[]
  outcomeReviews             OutcomeReview[]
  hypotheses                 Hypothesis[]
  hardGates                  HardGate[]
  ventureHandoffs            VentureHandoff[]

  @@map("opportunities")
}

model Industry {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?
  opportunities Opportunity[]
  personas      Persona[]

  @@map("industries")
}

model Persona {
  id            String        @id @default(cuid())
  name          String
  role          String
  industryId    String        @map("industry_id")
  description   String?
  painPoints    String?       @map("pain_points")
  opportunities Opportunity[]
  industry      Industry      @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@map("personas")
}

// ============================================================
// PAIN SIGNALS & CLUSTERS
// ============================================================

model PainSignal {
  id             String          @id @default(cuid())
  opportunityId  String          @map("opportunity_id")
  source         String
  sourceUrl      String?         @map("source_url")
  rawText        String          @map("raw_text")
  actorRole      String?         @map("actor_role")
  actorIndustry  String?         @map("actor_industry")
  job            String?
  pain           String?
  painIntensity  Int?            @map("pain_intensity")
  workaround     String?
  workaroundCost String?         @map("workaround_cost")
  consequence    String?
  confidence     Float           @default(0.5)
  language       String          @default("en")
  fetchedAt      DateTime        @default(now()) @map("fetched_at")
  clusterId      String?         @map("cluster_id")
  sourceId       String?         @map("source_id")
  opportunity    Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  cluster        PainCluster?    @relation(fields: [clusterId], references: [id])
  researchSource ResearchSource? @relation("SourcePainSignals", fields: [sourceId], references: [id])

  @@map("pain_signals")
}

model PainCluster {
  id              String       @id @default(cuid())
  opportunityId   String       @map("opportunity_id")
  label           String
  description     String?
  painSignals     PainSignal[]
  signalCount     Int          @default(0) @map("signal_count")
  avgIntensity    Float        @default(0) @map("avg_intensity")
  topWorkarounds  String?      @map("top_workarounds")
  topConsequences String?      @map("top_consequences")
  status          String       @default("active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  opportunity     Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("pain_clusters")
}

model OpportunityClaim {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  claim           String
  category        String
  confidence      Float       @default(0.5)
  sourceSignalIds String?     @map("source_signal_ids")
  sourceUrls      String?     @map("source_urls")
  status          String      @default("pending")
  createdAt       DateTime    @default(now()) @map("created_at")
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("opportunity_claims")
}

model Artifact {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  type          String
  title         String
  content       String?
  summary       String?
  sourceData    Json?       @map("source_data")
  status        String      @default("draft")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("artifacts")
}

// ============================================================
// SIGNALS & EVIDENCE (Extended with Evidence Strength Hierarchy)
// ============================================================

model Signal {
  id               String          @id @default(cuid())
  opportunityId    String          @map("opportunity_id")
  sourceId         String?         @map("source_id")
  type             String
  title            String
  description      String?
  source           String
  sourceUrl        String?         @map("source_url")
  data             Json?
  confidence       Float           @default(0.5)
  actorRole        String?         @map("actor_role")
  actorIndustry    String?         @map("actor_industry")
  job              String?
  pain             String?
  workaround       String?
  intent           String?
  impactTime       String?         @map("impact_time")
  impactMoney      String?         @map("impact_money")
  impactErrors     Boolean         @default(false) @map("impact_errors")
  revenueLoss      String?         @map("revenue_loss")
  verified         Boolean         @default(false)
  sourceHash       String?         @map("source_hash")
  isDuplicate      Boolean         @default(false) @map("is_duplicate")
  duplicateOfId    String?         @map("duplicate_of_id")
  isRelevant       Boolean         @default(true) @map("is_relevant")
  fetchedAt        DateTime        @default(now()) @map("fetched_at")
  evidenceStrength String?         @map("evidence_strength")
  direction        String?
  reliability      Float?
  recency          DateTime?
  independence     Boolean         @default(true)
  rawReference     String?         @map("raw_reference")
  opportunity      Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  researchSource   ResearchSource? @relation("SourceSignals", fields: [sourceId], references: [id])

  @@map("signals")
}

// ============================================================
// VALIDATION ENGINE: CORE
// ============================================================

model ValidationRun {
  id                          String           @id @default(cuid())
  opportunityId               String           @map("opportunity_id")
  sprintName                  String           @map("sprint_name")
  timeBoxDays                 Int              @default(21) @map("time_box_days")
  maxBudgetEur                Int              @default(8000) @map("max_budget_eur")
  spentEur                    Int              @default(0) @map("spent_eur")
  status                      String           @default("INTAKE")
  finalDecision               String?          @map("final_decision")
  finalDecisionAt             DateTime?        @map("final_decision_at")
  finalDecisionBy             String?          @map("final_decision_by")
  problemEvidenceScore        Int?             @map("problem_evidence_score")
  icpEvidenceScore            Int?             @map("icp_evidence_score")
  buyerClarityScore           Int?             @map("buyer_clarity_score")
  wtpScore                    Int?             @map("wtp_score")
  purchaseEvidenceScore       Int?             @map("purchase_evidence_score")
  solutionFitScore            Int?             @map("solution_fit_score")
  technicalFeasibilityScore   Int?             @map("technical_feasibility_score")
  distributionEvidenceScore   Int?             @map("distribution_evidence_score")
  unitEconomicsScore          Int?             @map("unit_economics_score")
  retentionEvidenceScore      Int?             @map("retention_evidence_score")
  overallValidationConfidence Float?           @map("overall_validation_confidence")
  startedAt                   DateTime?        @map("started_at")
  endedAt                     DateTime?        @map("ended_at")
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")
  opportunity                 Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  hypotheses                  Hypothesis[]
  experiments                 Experiment[]
  prospects                   Prospect[]
  interviews                  Interview[]
  offers                      Offer[]
  priceTests                  PriceTest[]
  proposals                   Proposal[]
  pilots                      Pilot[]
  paymentSignals              PaymentSignal[]
  technicalTests              TechnicalTest[]
  validationMemos             ValidationMemo[]
  conciergeRuns               ConciergeRun[]
  evidenceObjects             EvidenceObject[]
  hardGates                   HardGate[]

  @@map("validation_runs")
}

model Hypothesis {
  id                 String           @id @default(cuid())
  validationRunId    String           @map("validation_run_id")
  opportunityId      String           @map("opportunity_id")
  code               String
  type               String
  statement          String
  importance         Int              @default(5)
  failureImpact      Int              @default(5) @map("failure_impact")
  uncertainty        Float            @default(1.0)
  priorityScore      Float?           @map("priority_score")
  startingConfidence Float            @default(0.0) @map("starting_confidence")
  successThreshold   String?          @map("success_threshold")
  failureThreshold   String?          @map("failure_threshold")
  evidenceRequired   String?          @map("evidence_required")
  budgetEur          Int?             @map("budget_eur")
  deadline           DateTime?
  finalConfidence    Float?           @map("final_confidence")
  status             String           @default("untested")
  validatedAt        DateTime?        @map("validated_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  validationRun      ValidationRun    @relation(fields: [validationRunId], references: [id], onDelete: Cascade)
  opportunity        Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  experiments        Experiment[]
  evidenceObjects    EvidenceObject[]

  @@map("hypotheses")
}

// ============================================================
// EXPERIMENT ENGINE (Extended)
// ============================================================

model Experiment {
  id               String         @id @default(cuid())
  opportunityId    String         @map("opportunity_id")
  assumptionId     String?        @map("assumption_id")
  validationRunId  String?        @map("validation_run_id")
  hypothesisId     String?        @map("hypothesis_id")
  hypothesis       String
  method           String
  sampleTarget     Int            @default(0) @map("sample_target")
  successCriteria  Json?          @map("success_criteria")
  failureCriteria  Json?          @map("failure_criteria")
  channel          String?
  script           String?
  asset            String?
  evidenceStrength String?        @map("evidence_strength")
  owner            String?
  status           String         @default("planned")
  startDate        DateTime?      @map("start_date")
  endDate          DateTime?      @map("end_date")
  actualCost       Int?           @map("actual_cost")
  results          Json?
  conclusion       String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assumption       Assumption?    @relation(fields: [assumptionId], references: [id])
  validationRun    ValidationRun? @relation(fields: [validationRunId], references: [id])
  linkedHypothesis Hypothesis?    @relation(fields: [hypothesisId], references: [id])

  @@map("experiments")
}

// ============================================================
// CUSTOMER DISCOVERY: PROSPECTS & INTERVIEWS
// ============================================================

model Prospect {
  id              String        @id @default(cuid())
  validationRunId String        @map("validation_run_id")
  opportunityId   String        @map("opportunity_id")
  companyName     String        @map("company_name")
  companySize     String?       @map("company_size")
  geography       String?
  vertical        String?
  techStack       String?       @map("tech_stack")
  contactName     String?       @map("contact_name")
  contactRole     String?       @map("contact_role")
  contactEmail    String?       @map("contact_email")
  contactLinkedin String?       @map("contact_linkedin")
  isBuyer         Boolean       @default(false) @map("is_buyer")
  isChampion      Boolean       @default(false) @map("is_champion")
  isUser          Boolean       @default(false) @map("is_user")
  isEconomicBuyer Boolean       @default(false) @map("is_economic_buyer")
  isBlocker       Boolean       @default(false) @map("is_blocker")
  pipelineStatus  String        @default("target") @map("pipeline_status")
  outcome         String?
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  validationRun   ValidationRun @relation(fields: [validationRunId], references: [id], onDelete: Cascade)
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  interviews      Interview[]

  @@map("prospects")
}

model Interview {
  id                    String           @id @default(cuid())
  validationRunId       String           @map("validation_run_id")
  prospectId            String           @map("prospect_id")
  scheduledAt           DateTime         @map("scheduled_at")
  durationMinutes       Int?             @map("duration_minutes")
  interviewer           String?
  transcript            String?
  summary               String?
  extractedPain         String?          @map("extracted_pain")
  extractedFrequency    String?          @map("extracted_frequency")
  extractedSpend        String?          @map("extracted_spend")
  extractedBuyer        String?          @map("extracted_buyer")
  extractedUrgency      String?          @map("extracted_urgency")
  extractedQuotes       String?          @map("extracted_quotes")
  buyingSignals         String?          @map("buying_signals")
  contradictoryEvidence String?          @map("contradictory_evidence")
  evidenceObjects       EvidenceObject[]
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  validationRun         ValidationRun    @relation(fields: [validationRunId], references: [id], onDelete: Cascade)
  prospect              Prospect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

model WorkflowObservation {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  validationRunId String?     @map("validation_run_id")
  workflowName    String      @map("workflow_name")
  steps           String?
  currentTools    String?     @map("current_tools")
  painPoints      String?     @map("pain_points")
  timeSpent       String?     @map("time_spent")
  errorRate       String?     @map("error_rate")
  observer        String?
  companyName     String?     @map("company_name")
  observedAt      DateTime?   @map("observed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("workflow_observations")
}

// ============================================================
// PRICING & COMMERCIAL VALIDATION
// ============================================================

model Offer {
  id                  String        @id @default(cuid())
  validationRunId     String        @map("validation_run_id")
  name                String
