generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (NextAuth)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ============================================================
// USER & ORGANIZATION (Multi-Tenant)
// ============================================================

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime? @map("email_verified")
  image              String?
  avatarUrl          String?   @map("avatar_url")
  password           String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  memberships  Member[]
  ownedOrgs    Organization[] @relation("OwnedOrganizations")
  ventures     Venture[]

  @@map("users")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  status      String   @default("active")
  ownerId     String?  @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner       User?    @relation("OwnedOrganizations", fields: [ownerId], references: [id])
  members     Member[]

  @@map("organizations")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  roleId         String       @map("role_id")
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@map("members")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  label       String
  description String?
  level       Int          @default(0)
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now()) @map("created_at")

  members     Member[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  label       String
  category    String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// VENTURES
// ============================================================

model Venture {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?
  status        String        @default("idea") // idea, validation, mvp, growth, scale, sunset
  website       String?
  github        String?
  mrr           Int           @default(0)
  ownerId       String        @map("owner_id")
  opportunityId String?       @map("opportunity_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id])
  events        VentureEvent[]

  @@map("ventures")
}

model VentureEvent {
  id          String   @id @default(cuid())
  ventureId   String   @map("venture_id")
  type        String
  payload     Json
  actorId     String   @map("actor_id")
  createdAt   DateTime @default(now()) @map("created_at")

  venture     Venture  @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@map("venture_events")
}

// ============================================================
// OPPORTUNITY ENGINE (Complete)
// ============================================================

model Opportunity {
  id            String     @id @default(cuid())
  title         String
  description   String?
  
  // Pain Graph
  industryId    String?    @map("industry_id")
  personaId     String?    @map("persona_id")
  job           String?    // z.B. "Maintenance Coordination"
  pain          String?    // Fragmented intake, contractor follow-up
  workaround    String?    // WhatsApp, Excel, Email
  consequence   String?    // 5h/week, missed jobs, tenant complaints
  
  // Lösungsidee
  solution      String?
  targetGroup   String?    @map("target_group")
  businessModel String?    @map("business_model")
  
  // Two-Faktor Scoring (A = Opportunity Quality, B = Venture Fit)
  // Score A — Opportunity Quality (1-100)
  painSeverity      Int     @default(0) @map("pain_severity")      // 15 Punkte
  frequency         Int     @default(0) // 10 Punkte
  economicImpact    Int     @default(0) @map("economic_impact")      // 15 Punkte
  existingSpend     Int     @default(0) @map("existing_spend")       // 10 Punkte
  buyerClarity      Int     @default(0) @map("buyer_clarity")       // 10 Punkte
  reachability      Int     @default(0) // 10 Punkte
  competitionGap    Int     @default(0) @map("competition_gap")      // 10 Punkte
  switchingMotivation Int   @default(0) @map("switching_motivation") // 10 Punkte
  recurringNature   Int     @default(0) @map("recurring_nature")    // 5 Punkte
  evidenceQuality   Int     @default(0) @map("evidence_quality")    // 5 Punkte
  
  scoreA            Int     @default(0) @map("score_a") // Summe A (max 100)
  
  // Score B — Venture Fit (1-100)
  mvpSimplicity     Int     @default(0) @map("mvp_simplicity")       // 20 Punkte
  aiLeverage        Int     @default(0) @map("ai_leverage")           // 15 Punkte
  grossMargin       Int     @default(0) @map("gross_margin")            // 15 Punkte
  distributionAdvantage Int @default(0) @map("distribution_advantage") // 20 Punkte
  lowSupportBurden  Int     @default(0) @map("low_support_burden")    // 10 Punkte
  expansionPotential Int   @default(0) @map("expansion_potential")   // 10 Punkte
  defensibility     Int     @default(0) // 10 Punkte
  
  scoreB            Int     @default(0) @map("score_b") // Summe B (max 100)
  
  // Confidence & Evidence
  confidence        Float   @default(0.0) // 0.0 - 1.0
  evidenceLevel     Int     @default(0) @map("evidence_level") // 0-8
  biggestUncertainty String? @map("biggest_uncertainty")

  // Granular Validation Scores (0.0 - 1.0)
  problemValidation    Float   @default(0.0) @map("problem_validation")
  buyerValidation      Float   @default(0.0) @map("buyer_validation")
  pricingValidation    Float   @default(0.0) @map("pricing_validation")
  distributionValidation Float @default(0.0) @map("distribution_validation")
  solutionValidation   Float   @default(0.0) @map("solution_validation")
  
  // Marktdaten
  marketSize    String?    @map("market_size")
  competition   String?    // "low", "medium", "high"
  mrrEstimate   Int?       @map("mrr_estimate")
  
  // Erweiterte State Machine
  status        String     @default("discovered")
  // discovered → clustered → pain_verification → pain_verified → market_research → 
  // competition_research → business_analysis → fact_check → critic_review → scored → 
  // kill / watch / experiment / validating → score_update → human_gate → build_approved
  
  priority      String     @default("medium") // low, medium, high, urgent
  
  // Quelle
  source        String     @default("manual")
  sourceUrl     String?    @map("source_url")
  tags          String?
  
  // Evidence Engine
  supportingEvidenceCount   Int     @default(0) @map("supporting_evidence_count")
  contradictingEvidenceCount Int    @default(0) @map("contradicting_evidence_count")

  // Verknüpfungen
  signals       Signal[]
  painSignals   PainSignal[]
  painClusters  PainCluster[]
  claims        OpportunityClaim[]
  ventures      Venture[]
  gates         OpportunityGate[]
  assumptions   Assumption[]
  experiments   Experiment[]
  competitors   Competitor[]
  scoreComponents ScoreComponent[]
  stopConditions StopCondition[]
  researchBudgets ResearchBudget[]
  negativeEvidence NegativeEvidence[]
  artifacts     Artifact[]

  // Metadaten
  createdBy     String     @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  industry      Industry?   @relation(fields: [industryId], references: [id])
  persona       Persona?    @relation(fields: [personaId], references: [id])

  @@map("opportunities")
}

// ============================================================
// PAIN SIGNALS (Spezialisierte Signale für Pain-Points)
// ============================================================

model PainSignal {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  
  // Quelle
  source        String      // "reddit", "g2", "trustpilot", "forum", "interview"
  sourceUrl     String?     @map("source_url")
  rawText       String      @map("raw_text") // Originaler Text
  
  // Extrahierte Pain-Daten
  actorRole     String?     @map("actor_role") // "Operations Manager"
  actorIndustry String?     @map("actor_industry")
  job           String?     // "Maintenance Coordination"
  pain          String?     // Konkretes Problem
  painIntensity Int?        @map("pain_intensity") // 1-10
  workaround    String?     // Was machen sie stattdessen?
  workaroundCost String?     @map("workaround_cost") // "5h/week", "€500/month"
  consequence   String?     // "missed jobs", "tenant complaints"
  
  // Metadaten
  confidence    Float       @default(0.5)
  language      String      @default("en")
  fetchedAt     DateTime    @default(now()) @map("fetched_at")
  
  // Clustering
  clusterId     String?     @map("cluster_id")
  
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  cluster       PainCluster? @relation(fields: [clusterId], references: [id])

  @@map("pain_signals")
}

// ============================================================
// PAIN CLUSTERS (Gruppierte ähnliche Pain-Signale)
// ============================================================

model PainCluster {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  
  // Cluster-Daten
  label           String      // "Fragmented maintenance intake"
  description     String?     // Zusammenfassung
  painSignals     PainSignal[]
  
  // Metriken
  signalCount     Int         @default(0) @map("signal_count")
  avgIntensity    Float       @default(0) @map("avg_intensity")
  topWorkarounds  String?     @map("top_workarounds") // JSON Array
  topConsequences String?     @map("top_consequences") // JSON Array
  
  // Status
  status          String      @default("active") // active, merged, split, archived
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("pain_clusters")
}

// ============================================================
// OPPORTUNITY CLAIMS (Extrahierte Claims für Evidence)
// ============================================================

model OpportunityClaim {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  
  // Claim
  claim           String      // "Property managers lose 5h/week on maintenance"
  category        String      // "pain", "market", "competition", "buyer"
  confidence      Float       @default(0.5)
  
  // Quellen
  sourceSignalIds String?     @map("source_signal_ids") // JSON Array of IDs
  sourceUrls      String?     @map("source_urls") // JSON Array
  
  // Status
  status          String      @default("pending") // pending, verified, contradicted, uncertain
  
  createdAt       DateTime    @default(now()) @map("created_at")
  
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("opportunity_claims")
}

// ============================================================
// ARTIFACTS (Generierte Reports, Analysen, Dokumente)
// ============================================================

model Artifact {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  
  // Inhalt
  type            String      // "competitor_report", "market_analysis", "pain_summary", "experiment_report"
  title           String
  content         String?     // Markdown/HTML Content
  summary         String?     // Kurze Zusammenfassung
  
  // Quellen
  sourceData      Json?       @map("source_data") // Welche Daten wurden verwendet
  
  // Status
  status          String      @default("draft") // draft, published, archived
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("artifacts")
}

// ============================================================
// PAIN GRAPH
// ============================================================

model Industry {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  opportunities Opportunity[]
  personas    Persona[]
  
  @@map("industries")
}

model Persona {
  id          String   @id @default(cuid())
  name        String
  role        String   // z.B. "Operations Manager"
  industryId  String   @map("industry_id")
  description String?
  painPoints  String?  @map("pain_points") // JSON
  opportunities Opportunity[]
  
  industry    Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  
  @@map("personas")
}

// ============================================================
// SIGNALS & EVIDENCE
// ============================================================

model Signal {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  type          String      // "trend", "pain_point", "competitor", "keyword", "pricing"
  title         String
  description   String?
  source        String
  sourceUrl     String?     @map("source_url")
  data          Json?
  confidence    Float       @default(0.5)
  
  // Evidence Engine
  actorRole     String?     @map("actor_role")
  actorIndustry String?     @map("actor_industry")
  job           String?     // Was versucht die Person zu erledigen?
  pain          String?     // Konkretes Problem
  workaround    String?     // Was machen sie stattdessen?
  intent        String?     // complaint, question, recommendation
  impactTime    String?     @map("impact_time")
  impactMoney   String?     @map("impact_money")
  impactErrors  Boolean     @default(false) @map("impact_errors")
  revenueLoss   String?     @map("revenue_loss")
  verified      Boolean     @default(false)
  
  // Deduplication
  sourceHash    String?     @map("source_hash")
  isDuplicate   Boolean     @default(false) @map("is_duplicate")
  duplicateOfId String?     @map("duplicate_of_id")
  isRelevant    Boolean     @default(true) @map("is_relevant")
  
  fetchedAt     DateTime    @default(now()) @map("fetched_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("signals")
}

// ============================================================
// VALIDATION GATES
// ============================================================

model OpportunityGate {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  gateType        String      @map("gate_type")
  requirement     String?
  evidence        String?
  passed          Boolean     @default(false)
  passedAt        DateTime?   @map("passed_at")
  notes           String?

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("opportunity_gates")
}

// ============================================================
// ASSUMPTION ENGINE
// ============================================================

model Assumption {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  code            String      // A1, A2, A3...
  statement       String      // "Property managers need maintenance automation"
  category        String      // "problem", "buyer", "pricing", "distribution", "solution"
  
  // Validierung
  confidence      Float       @default(0.0) // 0.0 - 1.0
  evidenceCount   Int         @default(0) @map("evidence_count")
  status          String      @default("untested") // untested, testing, validated, invalidated
  
  // Nächster Experiment
  nextExperiment  String?     @map("next_experiment")
  estimatedCost   Int?        @map("estimated_cost") // in EUR
  estimatedDuration String?   @map("estimated_duration") // "5-7 days"
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  experiments     Experiment[]

  @@map("assumptions")
}

// ============================================================
// EXPERIMENT ENGINE
// ============================================================

model Experiment {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  assumptionId    String?     @map("assumption_id")
  
  hypothesis      String      // "Target buyers will pay at least €149/month"
  method          String      // "paid_pilot_offer", "interview", "landing_page", "demo"
  
  // Design
  sampleTarget    Int         @default(0) @map("sample_target")
  successCriteria Json?       @map("success_criteria") // { pilot_acceptances: 3 }
  failureCriteria Json?       @map("failure_criteria") // { pilot_acceptances: 0 }
  
  // Durchführung
  status          String      @default("planned") // planned, running, completed, failed
  startDate       DateTime?   @map("start_date")
  endDate         DateTime?   @map("end_date")
  actualCost      Int?        @map("actual_cost")
  
  // Ergebnisse → landen wieder im Evidence Store
  results         Json?       // { pilot_acceptances: 4, interviews_conducted: 15 }
  conclusion      String?     // "Hypothesis confirmed"
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assumption    Assumption? @relation(fields: [assumptionId], references: [id])

  @@map("experiments")
}

// ============================================================
// COMPETITOR ANALYSIS
// ============================================================

model Competitor {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  name            String
  type            String      // "direct", "indirect", "alternative"
  website         String?
  description     String?
  
  // Analyse
  pricing         String?     // Gefundene Pricing-Info
  strengths       String?
  weaknesses      String?
  gaps            String?     // Market gaps identified
  
  // Evidence
  reviewSources   String?     @map("review_sources")
  evidenceIds     String?     @map("evidence_ids") // Verknüpfte Evidence-IDs
  
  createdAt       DateTime    @default(now()) @map("created_at")

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("competitors")
}

// ============================================================
// SCORE COMPONENTS (Audit Trail)
// ============================================================

model ScoreComponent {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  factor          String      // "pain_severity", "mvp_simplicity", etc.
  category        String      // "A" (Opportunity Quality) oder "B" (Venture Fit)
  score           Int         // Punkte für diesen Faktor
  maxScore        Int         @map("max_score") // Maximal mögliche Punkte
  evidence        String?     // Begründung
  
  createdAt       DateTime    @default(now()) @map("created_at")

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("score_components")
}

// ============================================================
// TASK QUEUE (Orchestrator)
// ============================================================

model Task {
  id              String      @id @default(cuid())
  type            String      // "market_research", "competitor_research", "fact_check", "critic_review", "business_analysis"
  entityId        String      @map("entity_id") // opportunity_id oder venture_id
  entityType      String      @map("entity_type") // "opportunity" oder "venture"
  agent           String      // Welcher Agent soll das übernehmen
  priority        Int         @default(5) // 1-10
  status          String      @default("queued") // queued, running, completed, failed, retry, human_review
  attempts        Int         @default(0)
  maxAttempts     Int         @default(3) @map("max_attempts")
  
  // Ergebnis
  result          Json?       // Agent-Output
  error           String?     // Fehlermeldung bei failed
  
  // Budget
  estimatedCost   Int?        @map("estimated_cost") // in EUR
  actualCost      Int?        @map("actual_cost")
  
  // Zeiten
  startedAt       DateTime?   @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  
  // Verknüpfungen
  agentRuns       AgentRun[]

  @@map("tasks")
}

// ============================================================
// AGENT ARCHITECTUR
// ============================================================

model AgentRun {
  id              String      @id @default(cuid())
  taskId          String      @map("task_id")
  agentType       String      @map("agent_type") // "market_researcher", "competitor_researcher", "fact_checker", "critic_reviewer", "business_strategist", "financial_analyst"
  
  // Input/Output
  input           Json?       // Was der Agent bekommen hat
  output          Json?       // Was der Agent geliefert hat
  
  // Status
  status          String      @default("running") // running, completed, failed
  
  // Metriken
  tokensUsed      Int?        @map("tokens_used")
  runtimeSeconds  Int?        @map("runtime_seconds")
  cost            Float?      // Kosten für diesen Run
  
  startedAt       DateTime    @default(now()) @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  
  // Verknüpfungen
  task            Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messages        AgentMessage[]

  @@map("agent_runs")
}

model AgentMessage {
  id              String      @id @default(cuid())
  agentRunId      String      @map("agent_run_id")
  role            String      // "system", "user", "assistant", "tool"
  content         String
  toolCalls       Json?       @map("tool_calls") // Falls Tool Calls
  toolResults     Json?       @map("tool_results") // Falls Tool Results
  
  createdAt       DateTime    @default(now()) @map("created_at")
  
  agentRun        AgentRun    @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@map("agent_messages")
}

// ============================================================
// RESEARCH BUDGET
// ============================================================

model ResearchBudget {
  id              String      @id @default(cuid())
  opportunityId   String?     @map("opportunity_id")
  
  // Budget
  phase           String      // "quick_scan", "deep_research", "validation"
  maxRuntime      Int         @map("max_runtime") // in Minuten
  maxAgentRuns    Int         @map("max_agent_runs")
  minimumEvidence Int         @map("minimum_evidence")
  budgetEur       Int         @map("budget_eur")
  spentEur        Int         @default(0) @map("spent_eur")
  
  // Status
  status          String      @default("active") // active, exhausted, paused
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("research_budgets")
}

// ============================================================
// DECISIONS (Kill / Watch / Experiment)
// ============================================================

model Decision {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  
  type            String      // "kill", "watch", "experiment", "human_gate", "build_approved"
  reason          String      // Begründung
  
  // Trigger
  scoreA          Int?        @map("score_a")
  scoreB          Int?        @map("score_b")
  confidence      Float?
  evidenceLevel   Int?        @map("evidence_level")
  
  // Human Review
  reviewedBy      String?     @map("reviewed_by")
  reviewedAt      DateTime?   @map("reviewed_at")
  approved        Boolean     @default(false)
  
  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("decisions")
}

// ============================================================
// STOP CONDITIONS (Automated Kill/Watch/Experiment rules)
// ============================================================

model StopCondition {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  
  conditionType   String      @map("condition_type")
  // score_below_threshold, no_clear_buyer, no_repeated_problem, strong_competition_no_wedge,
  // economic_pain_unknown, wtp_unknown, distribution_unknown, evidence_sufficient,
  // budget_exhausted, time_exhausted, max_runs_reached
  
  threshold       Int?
  
  triggered       Boolean     @default(false)
  triggeredAt     DateTime?   @map("triggered_at")
  
  action          String      @default("none") // kill, watch, experiment, stop_research, human_review, none
  reason          String?
  
  createdAt       DateTime    @default(now()) @map("created_at")

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("stop_conditions")
}

// ============================================================
// NEGATIVE EVIDENCE (Contradictions)
// ============================================================

model NegativeEvidence {
  id              String      @id @default(cuid())
  opportunityId   String      @map("opportunity_id")
  claim           String      // z.B. "Property managers need another maintenance tool"
  contradiction   String      // z.B. "existing software already solves problem"
  source          String      // Quelle der Widerlegung
  confidence      Float       @default(0.5) // 0.0 - 1.0
  createdAt       DateTime    @default(now()) @map("created_at")

  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("negative_evidence")
}

