# ============================================================
# SAAS VENTURE STUDIO - Environment Variables
# Kopiere diese Datei zu .env.local (lokal) oder
# trage die Werte in Vercel Dashboard ein
# ============================================================

# --------------------------------------------------
# DATABASE (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# --------------------------------------------------
DATABASE_URL="postgresql://USER:***@HOST:PORT/DATABASE"

# --------------------------------------------------
# NEXTAUTH (Authentifizierung)
# --------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GENERIERE_EINEN_GEHEIMEN_SCHLUESSEL_64_ZEICHEN"

# --------------------------------------------------
# E-MAIL (Resend)
# --------------------------------------------------
RESEND_API_KEY="DEIN_RESEND_API_KEY"
EMAIL_FROM="noreply@deine-domain.de"

# --------------------------------------------------
# STRIPE (Optional - für Payment-Features)
# --------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --------------------------------------------------
# TELEMETRY
# 1 = disabled
# --------------------------------------------------
NEXT_TELEMETRY_DISABLED="1"
